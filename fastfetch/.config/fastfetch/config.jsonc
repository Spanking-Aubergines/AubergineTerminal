{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "width": 32,
    "padding": {
      "right": 3
    },
    "color": {
      "1": "#8294ad",
      "2": "#aab6c5",
      "3": "#64748b"
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 16
    },
    "color": {
      "keys": "#8294ad",
      "title": "#cbd5e1",
      "output": "#d1d5db",
      "separator": "#64748b"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#8fae9b",
        "yellow": "#b8a783",
        "red": "#b88989"
      }
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": "─"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "de",
      "key": "Desktop"
    },
    {
      "type": "wm",
      "key": "Window manager"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "temp": true
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Root",
      "folders": [
        "/"
      ]
    },
    {
      "type": "disk",
      "key": "4 TB HDD",
      "folders": [
        "/mnt/4tbHDD"
      ]
    },
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
