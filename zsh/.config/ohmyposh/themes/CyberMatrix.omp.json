{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
"transient_prompt": {
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"background": "transparent",
"foreground": "#00ff41",
"template": "\u27be "
 },
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"blocks": [
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#00ff41>\u250f[</>{{ .UserName }}<#00ff41>]</>",
"foreground": "#c9ffc9",
"type": "session",
"style": "plain"
 },
 {
"template": "<#00ff41>[</>\ue725 {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#ffb000>\uf044</>{{ end }}{{ if .Staging.Changed }} <#00ff41>\uf046</>{{ end }}<#00ff41>]</>",
"foreground": "#c9ffc9",
"type": "git",
"style": "plain",
"properties": {
"branch_max_length": 25,
"fetch_status": true,
"fetch_upstream_icon": true
 }
 },
 {
"template": "<#00ff41>[</><#ffb000>\uf0e7</><#00ff41>]</>",
"foreground": "#ffb000",
"type": "root",
"style": "plain"
 },
 {
"template": "<#00ff41>[x</><#ff2e5c>{{ reason .Code }}</><#00ff41>]</>",
"foreground": "#ff2e5c",
"type": "status",
"style": "plain"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "right",
"segments": [
 {
"properties": {
"style": "dallas",
"threshold": 0
 },
"template": " {{ .FormattedMs }}s <#c9ffc9>\ue601</>",
"foreground": "#00ff41",
"type": "executiontime",
"style": "diamond"
 },
 {
"properties": {
"root_icon": "\uf292 "
 },
"template": " \uf0e7 ",
"foreground": "#ffb000",
"type": "root",
"style": "diamond"
 },
 {
"template": " <#c9ffc9>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
"foreground": "#00a82d",
"type": "sysinfo",
"style": "diamond"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"properties": {
"style": "full"
 },
"template": "<#00ff41>\u2523[</>{{ .Path }}<#00ff41>]</>",
"foreground": "#c9ffc9",
"type": "path",
"style": "plain"
 }
 ],
"newline": true
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#00ff41>\u2517\u2b80 </>",
"foreground": "#c9ffc9",
"type": "text",
"style": "plain"
 }
 ],
"newline": true
 }
 ],
"final_space": false,
"version": 3
}
