{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
"transient_prompt": {
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"background": "transparent",
"foreground": "#ff0044",
"template": "\u27be "
 },
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"blocks": [
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#6600cc>\u250f[</>{{ .UserName }}<#6600cc>]</>",
"foreground": "#ff0044",
"type": "session",
"style": "plain"
 },
 {
"template": "<#6600cc>[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ end }}{{ if .Staging.Changed }} \uf046{{ end }}<#6600cc>]</>",
"foreground": "#ff0044",
"type": "git",
"style": "plain",
"properties": {
"branch_max_length": 25,
"fetch_status": true,
"fetch_upstream_icon": true
 }
 },
 {
"template": "<#6600cc>[</>\uf0e7<#6600cc>]</>",
"foreground": "#00cc99",
"type": "root",
"style": "plain"
 },
 {
"template": "<#6600cc>[x</>{{ reason .Code }}<#6600cc>]</>",
"foreground": "#00cc99",
"type": "status",
"style": "plain"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "right",
"segments": [
 {
"properties": {
"style": "dallas",
"threshold": 0
 },
"template": " {{ .FormattedMs }}s <#ff0044>\ue601</>",
"foreground": "#cc00ff",
"type": "executiontime",
"style": "diamond"
 },
 {
"properties": {
"root_icon": "\uf292 "
 },
"template": " \uf0e7 ",
"foreground": "#cc00ff",
"type": "root",
"style": "diamond"
 },
 {
"template": " <#ff0044>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
"foreground": "#ff0044",
"type": "sysinfo",
"style": "diamond"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"properties": {
"style": "full"
 },
"template": "<#6600cc>\u2523[</>{{ .Path }}<#6600cc>]</>",
"foreground": "#ff0044",
"type": "path",
"style": "plain"
 }
 ],
"newline": true
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#6600cc>\u2517\u2b80 </>",
"foreground": "#ff0044",
"type": "text",
"style": "plain"
 }
 ],
"newline": true
 }
 ],
"final_space": false,
"version": 3
}
