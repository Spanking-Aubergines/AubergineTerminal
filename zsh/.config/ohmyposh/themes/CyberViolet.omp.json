{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
"transient_prompt": {
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"background": "transparent",
"foreground": "#06b6d4",
"template": "\u27be "
 },
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"blocks": [
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#a855f7>\u250f[</>{{ .UserName }}<#a855f7>]</>",
"foreground": "#e9d5ff",
"type": "session",
"style": "plain"
 },
 {
"template": "<#a855f7>[</>\ue725 {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ end }}{{ if .Staging.Changed }} \uf046{{ end }}<#a855f7>]</>",
"foreground": "#e9d5ff",
"type": "git",
"style": "plain",
"properties": {
"branch_max_length": 25,
"fetch_status": true,
"fetch_upstream_icon": true
 }
 },
 {
"template": "<#a855f7>[</>\uf0e7<#a855f7>]</>",
"foreground": "#06b6d4",
"type": "root",
"style": "plain"
 },
 {
"template": "<#a855f7>[x</>{{ reason .Code }}<#a855f7>]</>",
"foreground": "#f43f5e",
"type": "status",
"style": "plain"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "right",
"segments": [
 {
"properties": {
"style": "dallas",
"threshold": 0
 },
"template": " {{ .FormattedMs }}s <#e9d5ff>\ue601</>",
"foreground": "#06b6d4",
"type": "executiontime",
"style": "diamond"
 },
 {
"properties": {
"root_icon": "\uf292 "
 },
"template": " \uf0e7 ",
"foreground": "#f43f5e",
"type": "root",
"style": "diamond"
 },
 {
"template": " <#e9d5ff>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
"foreground": "#ec4899",
"type": "sysinfo",
"style": "diamond"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"properties": {
"style": "full"
 },
"template": "<#a855f7>\u2523[</>{{ .Path }}<#a855f7>]</>",
"foreground": "#e9d5ff",
"type": "path",
"style": "plain"
 }
 ],
"newline": true
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#a855f7>\u2517\u2b80 </>",
"foreground": "#e9d5ff",
"type": "text",
"style": "plain"
 }
 ],
"newline": true
 }
 ],
"final_space": false,
"version": 3
}
