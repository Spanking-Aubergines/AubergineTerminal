{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
"transient_prompt": {
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"background": "transparent",
"foreground": "#00e6cc",
"template": "\u27be "
 },
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"blocks": [
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#ff7a00>\u250f[</>{{ .UserName }}<#ff7a00>]</>",
"foreground": "#b3d9ff",
"type": "session",
"style": "plain"
 },
 {
"template": "<#ff7a00>[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ end }}{{ if .Staging.Changed }} \uf046{{ end }}<#ff7a00>]</>",
"foreground": "#b3d9ff",
"type": "git",
"style": "plain",
"properties": {
"branch_max_length": 25,
"fetch_status": true,
"fetch_upstream_icon": true
 }
 },
 {
"template": "<#ff7a00>[</>\uf0e7<#ff7a00>]</>",
"foreground": "#ff4d6a",
"type": "root",
"style": "plain"
 },
 {
"template": "<#ff7a00>[x</>{{ reason .Code }}<#ff7a00>]</>",
"foreground": "#ff4d6a",
"type": "status",
"style": "plain"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "right",
"segments": [
 {
"properties": {
"style": "dallas",
"threshold": 0
 },
"template": " {{ .FormattedMs }}s <#b3d9ff>\ue601</>",
"foreground": "#00e6cc",
"type": "executiontime",
"style": "diamond"
 },
 {
"properties": {
"root_icon": "\uf292 "
 },
"template": " \uf0e7 ",
"foreground": "#ff4d6a",
"type": "root",
"style": "diamond"
 },
 {
"template": " <#b3d9ff>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
"foreground": "#9d4edd",
"type": "sysinfo",
"style": "diamond"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"properties": {
"style": "full"
 },
"template": "<#ff7a00>\u2523[</>{{ .Path }}<#ff7a00>]</>",
"foreground": "#b3d9ff",
"type": "path",
"style": "plain"
 }
 ],
"newline": true
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#ff7a00>\u2517\u2b80 </>",
"foreground": "#b3d9ff",
"type": "text",
"style": "plain"
 }
 ],
"newline": true
 }
 ],
"final_space": false,
"version": 3
}
