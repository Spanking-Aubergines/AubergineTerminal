{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
 "transient_prompt": {
  "console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
  "background": "transparent",
  "foreground": "#00ff7f",
  "template": "\u27be "
 },
 "console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
 "blocks": [
  {
   "type": "prompt",
   "alignment": "left",
   "segments": [
    {
     "template": "<#ff44aa>\u250f[</>{{ .UserName }}<#ff44aa>]</>",
     "foreground": "#00ccff",
     "type": "session",
     "style": "plain"
    },
    {
     "template": "<#ff44aa>[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ end }}{{ if .Staging.Changed }} \uf046{{ end }}<#ff44aa>]</>",
     "foreground": "#00ccff",
     "type": "git",
     "style": "plain",
     "properties": {
      "branch_max_length": 25,
      "fetch_status": true,
      "fetch_upstream_icon": true
     }
    },
    {
     "template": "<#ff44aa>[</>\uf0e7<#ff44aa>]</>",
     "foreground": "#ffaa00",
     "type": "root",
     "style": "plain"
    },
    {
     "template": "<#ff44aa>[x</>{{ reason .Code }}<#ff44aa>]</>",
     "foreground": "#ffaa00",
     "type": "status",
     "style": "plain"
    }
   ]
  },
  {
   "type": "prompt",
   "alignment": "right",
   "segments": [
    {
     "properties": {
      "style": "dallas",
      "threshold": 0
     },
     "template": " {{ .FormattedMs }}s <#00ccff>\ue601</>",
     "foreground": "#ff2a47",
     "type": "executiontime",
     "style": "diamond"
    },
    {
     "properties": {
      "root_icon": "\uf292 "
     },
     "template": " \uf0e7 ",
     "foreground": "#44bbff",
     "type": "root",
     "style": "diamond"
    },
    {
     "template": " <#00ccff>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
     "foreground": "#00ff7f",
     "type": "sysinfo",
     "style": "diamond"
    }
   ]
  },
  {
   "type": "prompt",
   "alignment": "left",
   "segments": [
    {
     "properties": {
      "style": "full"
     },
     "template": "<#ff44aa>\u2523[</>{{ .Path }}<#ff44aa>]</>",
     "foreground": "#00ccff",
     "type": "path",
     "style": "plain"
    }
   ],
   "newline": true
  },
  {
   "type": "prompt",
   "alignment": "left",
   "segments": [
    {
     "template": "<#ff44aa>\u2517\u2b80 </>",
     "foreground": "#00ccff",
     "type": "text",
     "style": "plain"
    }
   ],
   "newline": true
  }
 ],
 "final_space": false,
 "version": 3
}
