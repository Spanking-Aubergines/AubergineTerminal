{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
"transient_prompt": {
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"background": "transparent",
"foreground": "#00ff7f",
"template": "\u27be   "
 },
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"blocks": [
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#d4af37>\u250f[</>{{ .UserName }}<#d4af37>]</>",
"foreground": "#c8ccd4",
"type": "session",
"style": "plain"
 },
 {
"template": "<#d4af37>[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ end }}{{ if .Staging.Changed }} \uf046{{ end }}<#d4af37>]</>",
"foreground": "#c8ccd4",
"type": "git",
"style": "plain",
"properties": {
"branch_max_length": 25,
"fetch_status": true,
"fetch_upstream_icon": true
 }
 },
 {
"template": "<#d4af37>[</>\uf0e7<#d4af37>]</>",
"foreground": "#ff6b35",
"type": "root",
"style": "plain"
 },
 {
"template": "<#d4af37>[x</>{{ reason .Code }}<#d4af37>]</>",
"foreground": "#ff4081",
"type": "status",
"style": "plain"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "right",
"segments": [
 {
"properties": {
"style": "dallas",
"threshold": 0
 },
"template": " {{ .FormattedMs }}s <#c8ccd4>\ue601</>",
"foreground": "#00ff7f",
"type": "executiontime",
"style": "diamond"
 },
 {
"properties": {
"root_icon": "\uf292 "
 },
"template": " \uf0e7 ",
"foreground": "#ff6b35",
"type": "root",
"style": "diamond"
 },
 {
"template": " <#c8ccd4>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
"foreground": "#00bfff",
"type": "sysinfo",
"style": "diamond"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"properties": {
"style": "full"
 },
"template": "<#d4af37>\u2523[</>{{ .Path }}<#d4af37>]</>",
"foreground": "#c8ccd4",
"type": "path",
"style": "plain"
 }
 ],
"newline": true
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#d4af37>\u2517\u2b80 </>",
"foreground": "#c8ccd4",
"type": "text",
"style": "plain"
 }
 ],
"newline": true
 }
 ],
"final_space": false,
"version": 3
}
