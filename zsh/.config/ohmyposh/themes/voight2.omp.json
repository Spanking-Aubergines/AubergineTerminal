{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
"transient_prompt": {
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"background": "transparent",
"foreground": "#22c55e",
"template": "\u27be "
 },
"console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
"blocks": [
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#22c55e>\u250f[</>{{ .UserName }}<#22c55e>]</>",
"foreground": "#d1fae5",
"type": "session",
"style": "plain"
 },
 {
"template": "<#22c55e>[</>\ue725 {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#d97706>\uf044</>{{ end }}{{ if .Staging.Changed }} <#22c55e>\uf046</>{{ end }}<#22c55e>]</>",
"foreground": "#d1fae5",
"type": "git",
"style": "plain",
"properties": {
"branch_max_length": 25,
"fetch_status": true,
"fetch_upstream_icon": true
 }
 },
 {
"template": "<#22c55e>[</><#d97706>\uf0e7</><#22c55e>]</>",
"foreground": "#d97706",
"type": "root",
"style": "plain"
 },
 {
"template": "<#22c55e>[x</><#dc2626>{{ reason .Code }}</><#22c55e>]</>",
"foreground": "#dc2626",
"type": "status",
"style": "plain"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "right",
"segments": [
 {
"properties": {
"style": "dallas",
"threshold": 0
 },
"template": " {{ .FormattedMs }}s <#d1fae5>\ue601</>",
"foreground": "#16a34a",
"type": "executiontime",
"style": "diamond"
 },
 {
"properties": {
"root_icon": "\uf292 "
 },
"template": " \uf0e7 ",
"foreground": "#d97706",
"type": "root",
"style": "diamond"
 },
 {
"template": " <#d1fae5>MEM:</> {{ round .PhysicalPercentUsed .Precision }}% ({{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB)",
"foreground": "#15803d",
"type": "sysinfo",
"style": "diamond"
 }
 ]
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"properties": {
"style": "full"
 },
"template": "<#22c55e>\u2523[</>{{ .Path }}<#22c55e>]</>",
"foreground": "#d1fae5",
"type": "path",
"style": "plain"
 }
 ],
"newline": true
 },
 {
"type": "prompt",
"alignment": "left",
"segments": [
 {
"template": "<#22c55e>\u2517</><#16a34a>\u2b80 </>",
"foreground": "#d1fae5",
"type": "text",
"style": "plain"
 }
 ],
"newline": true
 }
 ],
"final_space": false,
"version": 3
}
